{
  "name": "json-reading",
  "displayName": "json_reading",
  "description": "为表格型 JSON 数据显示首行定义的字段名",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-reading.toggleFieldHintsMode",
        "title": "JSON Reading: 切换字段名提示（全部行 / 选中行）"
      },
      {
        "command": "json-reading.selectTableDirectory",
        "title": "JSON Reading: 选择策划表目录"
      },
      {
        "command": "json-reading.refreshTableIndex",
        "title": "JSON Reading: 刷新策划表索引"
      },
      {
        "command": "json-reading.selectTableWorkbook",
        "title": "JSON Reading: 选择当前 JSON 的策划工作簿"
      }
    ],
    "configuration": {
      "title": "JSON Reading",
      "properties": {
        "json-reading.fieldHints.displayMode": {
          "type": "string",
          "enum": [
            "selected",
            "all"
          ],
          "default": "selected",
          "enumDescriptions": [
            "仅在光标所在行或选中的行显示字段名",
            "在所有数据行显示字段名"
          ],
          "description": "字段名行尾提示的显示方式",
          "scope": "language-overridable"
        },
        "json-reading.tables.directory": {
          "type": "string",
          "default": "",
          "description": "策划表根目录。留空时不读取策划表；支持子目录扫描。相对路径基于第一个工作区文件夹。",
          "scope": "machine-overridable"
        },
        "json-reading.tables.registry": {
          "type": "string",
          "default": "",
          "description": "注册表路径，可相对于策划表根目录。留空时自动查找唯一的注册表.xlsm。",
          "scope": "window"
        },
        "json-reading.tables.fieldRow": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "字段英文名所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.descriptionRow": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 100,
          "description": "字段简述所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.detailRow": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 100,
          "description": "字段详细说明所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.workbookOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "同名页签的工作簿选择：键为 JSON 文件名（不含扩展名），值为相对于策划表根目录的 XLSM 路径。",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && node --test out/test/*.unit.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@types/yauzl": "^3.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  }
}
