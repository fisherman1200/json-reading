{
  "name": "json-reading",
  "publisher": "fff",
  "repository": {
    "type": "git",
    "url": "https://github.com/fisherman1200/json-reading.git"
  },
  "displayName": "json_reading",
  "icon": "media/json-reading.png",
  "description": "为表格型 JSON 数据显示首行定义的字段名",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-reading.addRelation",
        "title": "JSON Reading: 手动添加当前字段关联",
        "icon": "$(add)"
      },
      {
        "command": "json-reading.rescanRelations",
        "title": "JSON Reading: 手动全搜索当前字段的关联",
        "icon": "$(search)"
      },
      {
        "command": "json-reading.clearRelations",
        "title": "JSON Reading: 清空当前 JSON 的关联匹配表",
        "icon": "$(trash)"
      },
      {
        "command": "json-reading.syncTables",
        "title": "JSON Reading: 按当前 JSON 分支更新策划表",
        "icon": "$(sync)"
      },
      {
        "command": "json-reading.toggleFieldHintsMode",
        "title": "JSON Reading: 切换字段名提示（全部行 / 选中行）"
      },
      {
        "command": "json-reading.selectTableDirectory",
        "title": "JSON Reading: 选择策划表目录",
        "icon": "$(folder-opened)",
        "enablement": "!jsonReading.sidebar.busy"
      },
      {
        "command": "json-reading.clearTableDirectory",
        "title": "JSON Reading: 解除绑定策划表目录",
        "icon": "$(debug-disconnect)",
        "enablement": "jsonReading.sidebar.hasDirectory && !jsonReading.sidebar.busy"
      },
      {
        "command": "json-reading.refreshTableIndex",
        "title": "JSON Reading: 刷新策划表索引",
        "icon": "$(refresh)"
      },
      {
        "command": "json-reading.selectTableWorkbook",
        "title": "JSON Reading: 选择当前 JSON 的策划工作簿"
      },
      {
        "command": "json-reading.sidebar.refresh",
        "title": "JSON Reading: 刷新侧栏",
        "icon": "$(refresh)"
      },
      {
        "command": "json-reading.sidebar.sync",
        "title": "JSON Reading: 按当前 JSON 分支更新策划表",
        "icon": "$(sync)",
        "enablement": "jsonReading.sidebar.hasDocument && jsonReading.sidebar.hasDirectory && !jsonReading.sidebar.busy && isWorkspaceTrusted"
      },
      {
        "command": "json-reading.sidebar.add",
        "title": "JSON Reading: 添加字段关联",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted && !jsonReading.sidebar.busy && jsonReading.sidebar.hasDirectory"
      },
      {
        "command": "json-reading.sidebar.accept",
        "title": "JSON Reading: 确认或恢复关联",
        "icon": "$(check)",
        "enablement": "isWorkspaceTrusted && !jsonReading.sidebar.busy"
      },
      {
        "command": "json-reading.sidebar.reject",
        "title": "JSON Reading: 排除关联",
        "icon": "$(close)",
        "enablement": "isWorkspaceTrusted && !jsonReading.sidebar.busy"
      },
      {
        "command": "json-reading.sidebar.openWorkbook",
        "title": "JSON Reading: 打开关联策划表",
        "icon": "$(go-to-file)",
        "enablement": "isWorkspaceTrusted && !jsonReading.sidebar.busy"
      },
      {
        "command": "json-reading.sidebar.revealField",
        "title": "JSON Reading: 定位字段",
        "icon": "$(go-to-file)",
        "enablement": "isWorkspaceTrusted && !jsonReading.sidebar.busy"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "json-reading",
          "title": "JSON Reading",
          "icon": "media/json-reading.svg"
        }
      ]
    },
    "views": {
      "json-reading": [
        {
          "id": "json-reading.tableStatus",
          "name": "策划表"
        },
        {
          "id": "json-reading.relations",
          "name": "字段关联"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "json-reading.sidebar.refresh",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.sync",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.add",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.accept",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.reject",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.openWorkbook",
          "when": "false"
        },
        {
          "command": "json-reading.sidebar.revealField",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "json-reading.selectTableDirectory",
          "when": "view == json-reading.tableStatus",
          "group": "navigation@1"
        },
        {
          "command": "json-reading.clearTableDirectory",
          "when": "view == json-reading.tableStatus && jsonReading.sidebar.hasDirectory",
          "group": "navigation@2"
        },
        {
          "command": "json-reading.refreshTableIndex",
          "when": "view == json-reading.tableStatus",
          "group": "navigation@3"
        },
        {
          "command": "json-reading.sidebar.sync",
          "when": "view == json-reading.tableStatus",
          "group": "navigation@4"
        },
        {
          "command": "json-reading.sidebar.refresh",
          "when": "view == json-reading.relations",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "json-reading.sidebar.add",
          "when": "view == json-reading.relations && viewItem == jsonReadingField",
          "group": "inline@1"
        },
        {
          "command": "json-reading.sidebar.revealField",
          "when": "view == json-reading.relations && viewItem == jsonReadingField",
          "group": "navigation@1"
        },
        {
          "command": "json-reading.sidebar.accept",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetPending",
          "group": "inline@1"
        },
        {
          "command": "json-reading.sidebar.reject",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetPending",
          "group": "inline@2"
        },
        {
          "command": "json-reading.sidebar.reject",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetAccepted",
          "group": "inline@2"
        },
        {
          "command": "json-reading.sidebar.accept",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetRejected",
          "group": "inline@1"
        },
        {
          "command": "json-reading.sidebar.openWorkbook",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetPending",
          "group": "navigation@1"
        },
        {
          "command": "json-reading.sidebar.openWorkbook",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetAccepted",
          "group": "navigation@1"
        },
        {
          "command": "json-reading.sidebar.openWorkbook",
          "when": "view == json-reading.relations && viewItem == jsonReadingTargetRejected",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "JSON Reading",
      "properties": {
        "json-reading.relations.i18nFile": {
          "type": "string",
          "default": "",
          "description": "中文语言表路径。留空时读取当前 JSON 同目录的 i18zhConfigData.json；相对路径基于当前 JSON 目录。",
          "scope": "resource"
        },
        "json-reading.fieldHints.displayMode": {
          "type": "string",
          "enum": [
            "selected",
            "all"
          ],
          "default": "selected",
          "enumDescriptions": [
            "仅在光标所在行或选中的行显示字段名",
            "在所有数据行显示字段名"
          ],
          "description": "字段名行尾提示的显示方式",
          "scope": "language-overridable"
        },
        "json-reading.tables.directory": {
          "type": "string",
          "default": "",
          "description": "策划表根目录。留空时不读取策划表；支持子目录扫描。相对路径基于第一个工作区文件夹。",
          "scope": "machine-overridable"
        },
        "json-reading.tables.registry": {
          "type": "string",
          "default": "",
          "description": "注册表路径，可相对于策划表根目录。留空时自动查找唯一的注册表.xlsm。",
          "scope": "window"
        },
        "json-reading.tables.fieldRow": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "字段英文名所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.descriptionRow": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 100,
          "description": "字段简述所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.detailRow": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 100,
          "description": "字段详细说明所在行（从 1 开始）。",
          "scope": "window"
        },
        "json-reading.tables.workbookOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "同名页签的工作簿选择：键为 JSON 文件名（不含扩展名），值为相对于策划表根目录的 XLSM 路径。",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "prepackage": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\"",
    "package": "vsce package --out dist/ --skip-license",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && node --test out/test/*.unit.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@types/yauzl": "^3.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  }
}
